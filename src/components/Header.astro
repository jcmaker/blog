---
import { getPosts } from '../posts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	active?: string;
}

const { active } = Astro.props;
const categories = [...new Set((await getPosts()).map((post) => post.data.category))];
---

<header class="top">
	<div class="in">
		<a class="logo" href="/">justin<em>it</em></a>
		<nav>
			{
				categories.map((category) => (
					<a href={`/category/${category}/`} aria-current={category === active ? 'page' : undefined}>
						{category}
					</a>
				))
			}
			<a href="https://justincho.dev">소개</a>
			<a class="icon-link" href="/search/" aria-label="검색">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-3.5-3.5"></path>
				</svg>
			</a>
			<ThemeToggle />
		</nav>
	</div>
</header>
