---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="home" href="/">{SITE_TITLE}</a>
		<a href="https://justincho.dev">소개</a>
	</nav>
</header>
<style>
	header {
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		text-decoration: none;
	}
	.home {
		font-weight: 700;
	}
</style>
