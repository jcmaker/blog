---
import { getPosts } from '../posts';

interface Props {
	active?: string;
}

const { active } = Astro.props;
const categories = [...new Set((await getPosts()).map((post) => post.data.category))];
---

<header class="top">
	<div class="in">
		<a class="logo" href="/">justin<em>.</em>log</a>
		<nav>
			{
				categories.map((category) => (
					<a href={`/category/${category}/`} aria-current={category === active ? 'page' : undefined}>
						{category}
					</a>
				))
			}
			<a href="https://justincho.dev">소개</a>
		</nav>
	</div>
</header>
