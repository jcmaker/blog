---
// 목록 페이지 위쪽의 어두운 머리 영역. 제목은 slot으로 받는다.
interface Props {
	sub: string;
}

const { sub } = Astro.props;
---

<section class="hero">
	<div class="in">
		<div>
			<h1><slot /></h1>
			<p>{sub}</p>
		</div>
		<div class="glyphs" aria-hidden="true">
			<span class="g-sky">{'</>'}</span>
			<span class="g-c3">;</span>
			<span class="g-c4">::</span>
			<span class="g-dim">[ ]</span>
			<span class="g-c4">$_</span>
			<span class="g-dim">{'{ }'}</span>
			<span class="g-c3">{'=>'}</span>
			<span class="g-sky">~/</span>
		</div>
	</div>
</section>
