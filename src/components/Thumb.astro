---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	class?: string;
}

const { post, class: extra } = Astro.props;
const GLYPHS = ['</>', '{ }', ';', '::', '$_', '=>', '~/', '[ ]'];
// 글 주소로 무늬를 고른다. 같은 글은 언제나 같은 썸네일이 나온다.
const n = [...post.id].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
---

{
	post.data.heroImage ? (
		<Image class:list={['th', extra]} src={post.data.heroImage} width={720} height={480} alt="" />
	) : (
		<div class:list={['th', `t${n % 5}`, extra]} aria-hidden="true">
			<b>{GLYPHS[n % GLYPHS.length]}</b>
		</div>
	)
}
